{
  "name": "ayesicena",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "validate": "npm run typecheck && npm run test",
    "standalone": "node scripts/build-standalone.mjs",
    "verify:standalone": "node scripts/build-standalone.mjs && node scripts/prep-verify.mjs && node scripts/verify-standalone.mjs $PWD/standalone.html",
    "import-matrix": "python3 scripts/import-matrix.py data/ayesicena-matrix.xlsx",
    "book": "node scripts/build-book.mjs",
    "book:es": "node scripts/build-book.mjs --lang es",
    "market-run": "node --experimental-strip-types --import ./scripts/ts-alias.mjs scripts/build-market-run.mjs",
    "market-run:es": "node --experimental-strip-types --import ./scripts/ts-alias.mjs scripts/build-market-run.mjs --lang es"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "jose": "5.9.6",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/jest": "^29.5.12",
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "postcss": "^8.5.10",
    "tailwindcss": "3.4.7",
    "ts-node": "^10.9.2",
    "typescript": "5.5.4",
    "ts-jest": "^29.2.5"
  }
}
